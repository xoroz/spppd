#!/usr/bin/env bash
# Runs the headless tests on every core: one love process per shard, each taking
# every n-th test and saving into its own folder. Takes a filter like love . --test.
# SPPPD_TEST_SHARDS=n picks how many.
set -u
cd "$(dirname "$0")/.."
n=${SPPPD_TEST_SHARDS:-$(nproc)}
out=$(mktemp -d)
trap 'rm -rf "$out"' EXIT
trap 'kill $(jobs -p) 2>/dev/null; exit 130' INT TERM

pids=()
for i in $(seq 1 "$n"); do
  SPPPD_TEST_SHARD="$i/$n" love . --test "$@" > "$out/$i" 2>&1 &
  pids+=($!)
done

code=0 passed=0 failed=0
for i in $(seq 1 "$n"); do
  wait "${pids[$((i - 1))]}" || code=1
  summary=$(grep -E '^[0-9]+ passed, [0-9]+ failed$' "$out/$i")
  if [ -z "$summary" ]; then
    code=1
    echo "shard $i/$n stopped before the end:"
  fi
  sed -E '/^[0-9]+ passed, [0-9]+ failed$/d; /^  FAILED: /d; /^$/d' "$out/$i"
  set -- $summary
  passed=$((passed + ${1:-0})) failed=$((failed + ${3:-0}))
done

echo
echo "$passed passed, $failed failed ($n shards)"
grep -h '^  FAILED: ' "$out"/* 2>/dev/null
exit $code
